{
  "name": "live-recorder-desktop",
  "version": "0.1.27",
  "private": true,
  "description": "Local live recording workspace",
  "main": "electron/main.cjs",
  "scripts": {
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "tsc --noEmit && vite build --config vite.config.ts",
    "desktop": "npm run ui:build && electron .",
    "desktop:build-info": "node scripts/write_build_info.cjs",
    "desktop:runtime": "npm run ui:build && npm run desktop:build-info && python3 scripts/build_desktop_runtime.py",
    "desktop:pack": "npm run desktop:runtime && electron-builder --dir",
    "desktop:dist": "npm run desktop:runtime && electron-builder"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "build": {
    "appId": "com.boluzhushou.desktop",
    "productName": "Live Studio",
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/desktop-runtime/LiveRecorderRuntime",
        "to": "runtime/LiveRecorderRuntime"
      },
      {
        "from": "build/desktop-runtime/bin",
        "to": "runtime/bin"
      },
      {
        "from": "packaging/config.default.ini",
        "to": "defaults/config.default.ini"
      },
      {
        "from": "build/generated/build-info.json",
        "to": "build-info.json"
      },
      {
        "from": "首次启动引导.txt",
        "to": "docs/首次启动引导.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/app-icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "jsrsasign": "^11.1.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
